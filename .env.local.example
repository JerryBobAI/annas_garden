# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 创作公开分享页读取已完成作品（仅服务端，勿暴露到客户端）
SUPABASE_SERVICE_ROLE_KEY=

# AI — 智谱 GLM（默认）
GLM_API_KEY=your_glm_api_key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7-flash

# AI — OpenAI（可选，付费）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 语音 — browser（零成本）| siliconflow（推荐）| openai
VOICE_PROVIDER=browser
SILICONFLOW_API_KEY=

# 图片生成（可选，按优先级）
IMAGE_PROVIDER=
IMAGE_PROVIDER_ORDER=seedance,labnana,cogview,dalle
LABNANA_API_KEY=
ARK_API_KEY=

# 家长区 PIN（可选：未设置家庭 PIN 时的全站过渡兜底，新用户应在首次进入家长区时设置专属 PIN）
PARENT_ACCESS_PIN=

# 定时报告 Cron 认证
CRON_SECRET=your_random_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API 限流（每分钟，可选；默认见 lib/api/rate-limit.ts）
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_IMAGE_PER_MIN=10
RATE_LIMIT_VOICE_PER_MIN=20
RATE_LIMIT_REPORTS_PER_MIN=5

# E2E 测试账号（可选）
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
